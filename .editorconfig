root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 80

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.{json,yaml,yml,toml,md}]
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_style = space
indent_size = 4
